---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stance from '../components/Stance.astro';
import { JURISDICTIONS, ORDER, live, planned } from '../data/jurisdictions';

const all = (await getCollection('opinion', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const countBy = (code) => all.filter((p) => p.data.jurisdiction === code).length;
const fmt = (d, loc) => d.toLocaleDateString(loc, { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base path="/">
  <div class="eyebrow">Coverage</div>
  {/* Only countries with something published. A tile reading "planned" tells
      the reader nothing they can use and makes the site look like a promise
      rather than a publication. A country appears the moment it has a piece. */}
  <div class="silos">
    {ORDER.filter((code) => countBy(code) > 0).map((code) => {
      const j = JURISDICTIONS[code];
      const n = countBy(code);
      return (
        <a class="silo" href={`/${code}/`}>
          <span class="silo-code">{code === 'general' ? 'XB' : code.toUpperCase()}</span>
          <span class="silo-name">{j.name}</span>
          <span class="silo-n">{n} {n === 1 ? 'piece' : 'pieces'}</span>
        </a>
      );
    })}
  </div>

  <div class="eyebrow">Latest</div>
  {all.map((p) => {
    const j = JURISDICTIONS[p.data.jurisdiction];
    return (
      <article class="card">
        <div class="card-top">
          <span class="jflag">{p.data.jurisdiction === 'general' ? 'XB' : p.data.jurisdiction.toUpperCase()}</span>
          <span class="kicker">{p.data.kicker}</span>
          <span class="byline">{fmt(p.data.date, j.dateLocale)}</span>
        </div>
        <h2 class="headline"><a href={`/${p.data.jurisdiction}/${p.id.split('/').pop()}/`}>{p.data.title}</a></h2>
        <p class="dek">{p.data.dek}</p>
        {p.data.compares && (
          <p class="compares">Compares {p.data.compares.map((c) => JURISDICTIONS[c].name).join(', ')}</p>
        )}
        {/* A listing card carries the dek and the view in one line. It does NOT
          carry the full position and falsifier — two paragraphs each, six
          articles deep, put several thousand words on the front page and
          buried the headlines they were meant to support. */}
      {p.data.viewInBrief && (
        <p class="card-view"><span class="card-view-tag">Our view</span>{p.data.viewInBrief}</p>
      )}
      </article>
    );
  })}
</Base>
