---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stance from '../../components/Stance.astro';
import { JURISDICTIONS, ORDER } from '../../data/jurisdictions';

export async function getStaticPaths() {
  /*
   * ONE CONDITION DECIDES EVERYTHING: does this country have a published piece?
   *
   * Not the status flag in jurisdictions.ts. An earlier version built routes
   * from status === 'live' while the homepage grid built tiles from the piece
   * count, so the first article in a country still marked 'planned' would have
   * produced a tile linking to a page that was never built.
   *
   * Driving both off the content means a new country needs no code change at
   * all. Publish a piece into src/content/opinion/nz/ and New Zealand appears
   * on the next build, tile and page together.
   */
  const all = await getCollection('opinion', ({ data }) => !data.draft);
  const populated = new Set(all.map((p) => p.data.jurisdiction));
  return ORDER
    .filter((code) => populated.has(code))
    .map((code) => ({ params: { jurisdiction: code }, props: { code } }));
}
const { code } = Astro.props;
const j = JURISDICTIONS[code];
const pieces = (await getCollection('opinion', ({ data }) => !data.draft && data.jurisdiction === code))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString(j.dateLocale, { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={j.name} description={`Opinion on ${j.name}.`} path={`/${code}/`}>
  <a class="back" href="/">&larr; All opinion</a>
  <div class="eyebrow">{j.name}</div>

  {j.regime && (
    <div class="note">
      <b>Regulated by {j.conduct.join(', ')}.</b>
      {j.centralBank && <> Monetary authority: {j.centralBank}.</>}<br />
      The regime that governs published opinion here: {j.regime}.
    </div>
  )}

  {pieces.length === 0 && (
    <div class="note">Nothing in this silo yet.</div>
  )}

  {pieces.map((p) => (
    <article class="card">
      <div class="card-top">
        <span class="kicker">{p.data.kicker}</span>
        <span class="byline">{p.data.author} &middot; {fmt(p.data.date)}</span>
      </div>
      <h2 class="headline"><a href={`/${code}/${p.id.split('/').pop()}/`}>{p.data.title}</a></h2>
      <p class="dek">{p.data.dek}</p>
      {p.data.viewInBrief && (
        <p class="card-view"><span class="card-view-tag">Our view</span>{p.data.viewInBrief}</p>
      )}
    </article>
  ))}
</Base>
