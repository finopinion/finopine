---
import Base from '../layouts/Base.astro';
import wire from '../../wire.json';

/**
 * READER-FACING. No internal state on this page.
 *
 * A source with a confirmed URL is a link. A source without one is plain text.
 * The reader is never told which is which, why, or what tooling decides it —
 * that is the operator's business and it lives in check-wire.mjs and
 * check-launch.mjs. A page that explains its own incompleteness is a page that
 * has confused two audiences.
 */
const linked = wire.groups.flatMap(g => g.sources).filter(s => s.verified === true && s.url).length;
---
<Base title="The Wire" description="Every source FinOpine reads before forming a view." path="/wire/">
  <div class="eyebrow">The Wire</div>
  <h1 class="art-title">Everything read before a view is formed.</h1>
  <p class="art-dek">
    Ordered from primary to interpretation. If an argument on this site rests on
    a number, it should be traceable to something in the first two groups.
  </p>

  {wire.groups.map((g) => (
    <div class="wire-grp">
      <h3>{g.name}</h3>
      <p class="why">{g.why}</p>
      <ul>
        {g.sources.map((s) => (
          <li>
            <span class={s.tier === 'daily' ? 'tier p' : 'tier'}>{s.tier}</span>
            <b>
              {s.verified && s.url
                ? <a href={s.url} rel="noopener">{s.name}</a>
                : s.name}
            </b>
            {s.what && <span>{s.what}</span>}
          </li>
        ))}
      </ul>
    </div>
  ))}
</Base>
