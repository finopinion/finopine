---
import Base from '../layouts/Base.astro';
import wire from '../../wire.json';

/**
 * A source appears here only if it has a URL that has been confirmed live.
 *
 * No unlinked names. A directory you cannot click is not a directory, and an
 * entry that only tells you a publisher exists is telling the reader something
 * they already knew. Empty groups drop out with their heading.
 *
 * The consequence is that this page is only as good as check-wire.mjs has
 * confirmed. That is the intended trade.
 */
const groups = wire.groups
  .map((g) => ({ ...g, sources: g.sources.filter((s) => s.verified === true && s.url) }))
  .filter((g) => g.sources.length > 0);

const total = groups.reduce((n, g) => n + g.sources.length, 0);
---
<Base title="The Wire" description="Every source FinOpine reads before forming a view." path="/wire/">
  <div class="eyebrow">The Wire</div>
  <h1 class="art-title">Everything read before a view is formed.</h1>
  <p class="art-dek">
    Ordered from primary to interpretation. If an argument on this site rests on
    a number, it should be traceable to something in the first group.
  </p>

  {groups.map((g) => (
    <div class="wire-grp">
      <h3>{g.name}</h3>
      <p class="why">{g.why}</p>
      <ul>
        {g.sources.map((s) => (
          <li>
            <span class={s.tier === 'daily' ? 'tier p' : 'tier'}>{s.tier}</span>
            <b><a href={s.url} rel="noopener">{s.name}</a></b>
            {s.what && <span>{s.what}</span>}
          </li>
        ))}
      </ul>
    </div>
  ))}

  {total === 0 && (
    <p class="dek">This page is being rebuilt.</p>
  )}
</Base>
