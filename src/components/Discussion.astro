---
import { SITE } from '../data/site';
/**
 * Degrade quietly. The reader gets a route that works, not a status report on
 * what has not been built. "Phase two" and "needs a datastore" are operator
 * concerns.
 */
---
{SITE.discussion.enabled ? (
  <div id="discussion" data-board></div>
) : SITE.publisher.email ? (
  <div class="note">
    <b>Disagree?</b> Write to <a href={`mailto:${SITE.publisher.email}`}>{SITE.publisher.email}</a>.
    Corrections are published.
  </div>
) : null}
